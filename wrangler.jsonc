{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fortresspreservationllc",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Generated by `opennextjs-cloudflare build`.
  // Use `npm run deploy` in CI, not raw `npx wrangler deploy`.
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "property-preservation-cms-opennext-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fortresspreservationllc"
    }
  ],
  "custom_domains": [
    "fortresspreservationllc.com",
    "www.fortresspreservationllc.com"
  ],
  "build": {
    "command": "npx @opennextjs/cloudflare build"
  }
}

