{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fortresspreservationllc",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Generated by `opennextjs-cloudflare build`.
  // Use `npm run deploy` in CI, not raw `npx wrangler deploy`.
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "property-preservation-cms-opennext-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "property-preservation-cms",
      "database_id": "456aa094-27ce-46e8-8571-ebf7f382ef75"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fortresspreservationllc"
    }
  ],
  "build": {
    "command": "npx @opennextjs/cloudflare build"
  }
}

